# Copy to `.env.local` in this directory and fill in.
#
#   cp apps/web/.env.example apps/web/.env.local
#
# `.env.local` is gitignored — never commit real tokens.
#
# Next.js loads this file automatically for the web app. The command-line tools
# (`npm run db:backup`, `db:restore`, `db:seed`) read it too, so in development
# this one file is all you need.
#
# In production these come from systemd instead — see deploy/backup.env.example.

# --- Vercel Blob -----------------------------------------------------------
# Vercel dashboard → Storage → your Blob store → the ".env.local" tab.
# Used for material/pattern photos and for encrypted database backups.
# Treat it like a password: it grants read AND write to the whole store.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx

# --- Backups (only needed if you run backups from this machine) -------------
# Generate with: openssl rand -base64 32
# LOSE THIS AND EVERY BACKUP IS PERMANENTLY UNREADABLE. Store a copy somewhere
# that is neither this machine nor the blob store.
# BACKUP_PASSPHRASE=

# --- Site login (only needed when exposing this beyond localhost) -----------
# Leaving both unset disables the login check entirely — fine for local dev.
# Enforced in middleware.ts. After 3 wrong passwords in a row the site locks
# regardless of what's typed next, until the server restarts or someone runs:
#   UPDATE auth_lockout SET failed_attempts = 0, locked = 0 WHERE id = 1;
# AUTH_USERNAME=
# AUTH_PASSWORD=

# --- Optional overrides ------------------------------------------------------
# Defaults to <repo>/data/vimar.db
# DATABASE_PATH=
