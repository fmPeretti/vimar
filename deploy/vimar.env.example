# Runtime config for the vimar-web container, loaded by docker-compose's
# env_file.
#
#   install -D -m 0600 deploy/vimar.env.example deploy/vimar.env
#   nano deploy/vimar.env
#
# deploy/vimar.env is gitignored — never commit real values into this file.
# DATABASE_PATH is set directly in docker-compose.yml, not here — leave it out.

# --- Vercel Blob -------------------------------------------------------------
# Vercel dashboard -> Storage -> your Blob store -> the ".env.local" tab.
# Used for material/pattern photos and for encrypted database backups.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx

# --- Site login ---------------------------------------------------------------
# Leaving both unset disables the check. Locks after 3 wrong passwords in a
# row until the container restarts or someone clears auth_lockout by hand —
# see the "Site login" section in README.md.
AUTH_USERNAME=
AUTH_PASSWORD=

# --- Backups -------------------------------------------------------------
# Only needed if you run `npm run db:backup` *inside* the container instead
# of on the host against the bind-mounted data directory (the documented,
# recommended path — see deploy/BACKUPS.md).
# BACKUP_PASSPHRASE=
