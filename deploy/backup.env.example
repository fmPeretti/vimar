# Environment for the Vimar backup job.
#
# Install to /etc/vimar/backup.env, owned by root, mode 0600:
#
#   sudo install -D -m 0600 deploy/backup.env.example /etc/vimar/backup.env
#   sudo nano /etc/vimar/backup.env
#
# ---------------------------------------------------------------------------
# THE PASSPHRASE IS THE BACKUP.
#
# Lose it and every encrypted copy is permanently unreadable — there is no
# recovery path, by design. Store it somewhere that is NOT this server and NOT
# the blob store: a password manager, or on paper.
#
# Generate a strong one:
#   openssl rand -base64 32
# ---------------------------------------------------------------------------
BACKUP_PASSPHRASE=replace-me-with-the-output-of-openssl-rand-base64-32

# Where the live database lives. Must match what the app uses.
DATABASE_PATH=/opt/vimar/data/vimar.db

# Where encrypted backups are written before being uploaded.
BACKUP_DIR=/opt/vimar/backups

# How many backups to retain, locally and in the store.
# Daily backups + 14 = two weeks of history.
BACKUP_KEEP=14

# ---------------------------------------------------------------------------
# Destination: "blob" (Vercel Blob, default) or "git".
# ---------------------------------------------------------------------------
BACKUP_TARGET=blob

# --- Vercel Blob -----------------------------------------------------------
# From the Vercel dashboard: Storage -> your Blob store -> the .env.local tab.
# This is a read/write token: treat it like a password.
#
# It is NOT tied to Next.js or to hosting on Vercel — the SDK is a plain HTTPS
# client, so this works from any server.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me

# Folder within the store. Backups are uploaded with access: private.
BACKUP_BLOB_PREFIX=backups/

# --- git (only when BACKUP_TARGET=git) --------------------------------------
# The branch is force-pushed and kept at a single commit — never point this at
# a branch you develop on. The tool refuses obvious names, but be careful.
# BACKUP_GIT_REMOTE=origin
# BACKUP_GIT_BRANCH=backups
